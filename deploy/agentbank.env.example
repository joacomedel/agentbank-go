# Config de ejemplo para /etc/agentbank/env (modo 0600).
# No commitear valores reales.

AGENTBANK_ADDR=127.0.0.1:8090
AGENTBANK_DB=/var/lib/agentbank/agentbank.db
AGENTBANK_LOG_LEVEL=info
AGENTBANK_MAX_BODY_BYTES=1048576

# Para exponer solo por ZeroTier:
# AGENTBANK_ADDR=10.27.103.203:8090

# Para un frontend local en desarrollo:
# AGENTBANK_CORS_ORIGINS=http://localhost:5173
