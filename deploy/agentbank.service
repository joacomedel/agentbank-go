[Unit]
Description=AgentBank Go (API de tareas para agentes)
Documentation=file:/usr/local/share/doc/agentbank/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentbank
Group=agentbank
WorkingDirectory=/var/lib/agentbank
StateDirectory=agentbank
EnvironmentFile=-/etc/agentbank/env
ExecStart=/usr/local/bin/agentbank
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

# Bajo consumo en el Moto. El controlador cpu de cgroup no está disponible
# en este kernel; se usa Nice. MemoryMax sí funciona.
MemoryHigh=96M
MemoryMax=128M
Nice=10
TasksMax=64
OOMScoreAdjust=300

# Endurecimiento básico.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agentbank
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
